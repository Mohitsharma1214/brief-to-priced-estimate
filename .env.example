# ============================================================================
# Brief to Priced Estimate - Environment Configuration Example
# ============================================================================
# Copy this file to .env and configure as needed.
# NEVER commit .env containing actual secrets or API keys to version control.

# OpenRouter API Key (Required ONLY for live LLM extraction; unit tests run offline)
OPENROUTER_API_KEY=

# OpenRouter Model Identifier (Optional - default: meta-llama/llama-3.3-70b-instruct)
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# OpenRouter Base URL (Optional - default: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM Request Timeout in seconds (Optional - default: 15.0)
# LLM_TIMEOUT_SECONDS=15.0

# LLM Maximum Retries on Malformed Output (Optional - default: 2)
# LLM_MAX_RETRIES=2

# Catalog Inventory Path (Optional - defaults to auto-resolving inventory/products.json)
# INVENTORY_PATH=inventory/products.json
